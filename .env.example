PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Optional: local Firebase Auth + Firestore emulators. Never enable in production.
PUBLIC_USE_EMULATORS=false

# Privato: email Google verificate separate da virgola. Vuoto = nessun accesso.
ALLOW_LIST=
# Privato: JSON service account (stessa convenzione di BacaroGame), solo sul server.
FIREBASE_ADMIN_KEY=

# Amministratori permanenti: email Google separate da virgola, solo server
SUPERADMIN_EMAILS=
