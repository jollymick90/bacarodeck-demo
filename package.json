{
  "name": "bacarotech-interview-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bacarodeck 'vitest run tests/rules.test.ts'",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,svelte}\" src/app.css \"tests/**/*.ts\" \"*.{ts,js,json}\" schemas/*.json"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@vercel/functions": "^3.10.1",
    "ajv": "^8.17.1",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.5.0",
    "marked": "^16.0.0",
    "sanitize-html": "^2.17.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-vercel": "^6.0.0",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/three": "^0.186.0",
    "firebase-tools": "^14.17.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    },
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
